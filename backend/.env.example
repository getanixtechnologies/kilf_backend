# --- Server ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Public API base URL used by Swagger (/api/docs). Production: https://api.kilf.in
# API_URL=https://api.kilf.in

# --- Database ---
# Local dev (matches docker-compose.yml):
DATABASE_URL=postgresql://kilf:kilf@localhost:5432/kilf?schema=public

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# --- Payments (mock provider by default) ---
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=dev-mock-payment-secret

# --- Razorpay (only required when PAYMENT_PROVIDER=razorpay) ---
# Get these from Razorpay Dashboard > Settings > API Keys, and
# Settings > Webhooks (create a webhook pointed at /api/webhooks/razorpay,
# subscribed to payment.captured, payment.failed, refund.processed, and set
# its secret below - it must match RAZORPAY_WEBHOOK_SECRET exactly).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Booking ---
BOOKING_HOLD_MINUTES=15

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- File uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# --- Logging ---
LOG_LEVEL=info

# --- Ticket numbers ---
# Ticket numbers are `${TICKET_NUMBER_PREFIX}-<year>-000123`; checkers type only the suffix.
TICKET_NUMBER_PREFIX=LF

# --- Checker credential emails ---
# Login link in the email. Prod: https://admin.kilf.in/login  Dev: https://admin.dev.kilf.in/login
# Defaults to ${ADMIN_URL}/login when unset.
ADMIN_LOGIN_URL=
# SMTP (e.g. Hostinger: smtp.hostinger.com, 465, SMTP_SECURE=true). Unset SMTP_HOST = log only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=KILF <no-reply@kilf.in>
