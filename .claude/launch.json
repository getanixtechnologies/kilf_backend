{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin-panel-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "admin-panel", "run", "dev", "--", "--port", "5180", "--strictPort"],
      "port": 5180,
      "autoPort": false
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd backend && set FRONTEND_URL=http://localhost:5180&& set PORT=4001&& npm run dev"],
      "port": 4001,
      "autoPort": false
    }
  ]
}
